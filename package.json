{
  "name": "neon-ronin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5195",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5195",
    "generate": "node scripts/generate.mjs",
    "chain": "npm --prefix contracts run node",
    "contracts:test": "npm --prefix contracts test",
    "deploy:local": "npm --prefix contracts run deploy:local",
    "deploy:sepolia": "npm --prefix contracts run deploy:sepolia",
    "deploy:robinhood": "npm --prefix contracts run deploy:robinhood",
    "mint:open": "npm --prefix contracts run mint:open",
    "reveal": "node scripts/reveal.mjs",
    "contract:reveal": "npm --prefix contracts run reveal",
    "contract:withdraw": "npm --prefix contracts run withdraw"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/zen-kaku-gothic-new": "^5.2.0",
    "@gsap/react": "^2.1.2",
    "ethers": "^6.17.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.3"
  }
}
